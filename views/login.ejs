<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin login</title>
    <link rel="stylesheet" href="/css/form.css">
</head>
<body>
    <main>
        <div class="head">
            <h1>Login to Admin Account</h1>
        </div>
        <div class="form">
            <form action="/admin/login" method="POST">
            <label>Username:</label>
            <input type="text" name="username" placeholder="Username" style="margin-bottom: 20px;" required>
            <label>Password:</label>  
            <input type="password" name="password" placeholder="Password" style="margin-bottom: 20px;" required>
            <button type="submit" style="margin-top: 20px;">Login</button>
            </form>
        </div>
    </main>
    <%- include('footer') %>
</body>
</html>